{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["contracts/*"]
    }
  },
  "include": ["contracts/**/*.ts", "src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "supabase/functions"]
}

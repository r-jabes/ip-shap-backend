# Optional notepad for CLI / scripts — hosted app uses frontend/.env
# Migrations: prefer `supabase link` + `npm run db:push` (no .env required)

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only if you need direct Postgres (psql / dump) — not required for db:push
# SUPABASE_DB_URL=

{
  "name": "ip-shap-backend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=critical",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:seed:p1": "npx supabase db query --linked --file supabase/seed/p1_minimal_catalogue.sql",
    "db:seed:admins": "node --env-file=.env.local scripts/seed-admins.mjs",
    "db:rls-smoke": "npx supabase db query --linked --file supabase/seed/rls_smoke_checks.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
